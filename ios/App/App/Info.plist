<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<!-- Read API base + client key for native App Intents (BodegaIntents.swift).
	     Same low-trust ingestion key the web bundle and App Clip ship. -->
	<key>BODEGA_API_BASE_URL</key>
	<string>https://bodega-gateway-2q60deae.ue.gateway.dev</string>
	<key>BODEGA_API_KEY</key>
	<string>AIzaSyA31lUH4vxxewg7Jgoj8kZS9wJ0p9O0NKs</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- Languages the app declares support for. Required so WKWebView reports the
	     device's preferred language to navigator.languages (src/i18n detectLanguage);
	     without it iOS always reports en. Keep in sync with SUPPORTED_LANGS. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>zh</string>
		<string>ru</string>
		<string>bn</string>
		<string>el</string>
		<string>ht</string>
		<string>ko</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Bodega Finder</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- App uses only standard HTTPS/TLS (exempt encryption), so skip the
	     export-compliance prompt on every submission. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Bodega uses your location to find bodegas near you.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Bodega uses your location to find bodegas near you.</string>
	<key>NSCameraUsageDescription</key>
	<string>Bodega uses the camera so you can photograph a receipt or storefront when reporting a bodega.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Bodega needs access to your photos so you can attach a receipt or storefront image when reporting a bodega.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
