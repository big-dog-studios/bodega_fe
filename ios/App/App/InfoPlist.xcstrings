    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega আপনার ফটোতে অ্যাক্সেস প্রয়োজন যাতে আপনি কোনো বোডেগা রিপোর্ট করার সময় রসিদ বা দোকানের ছবি যুক্ত করতে পারেন।"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Bodega χρειάζεται πρόσβαση στις φωτογραφίες σας ώστε να επισυνάπτετε μια απόδειξη ή εικόνα βιτρίνας όταν αναφέρετε ένα μπακάλικο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega needs access to your photos so you can attach a receipt or storefront image when reporting a bodega."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega necesita acceso a tus fotos para que puedas adjuntar un recibo o una imagen de la fachada al reportar una bodega."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega bezwen aksè a foto ou yo pou ou ka tache yon resi oswa yon imaj devan magazen lè w ap rapòte yon bodega."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega는 가게를 제보할 때 영수증이나 매장 이미지를 첨부할 수 있도록 사진에 대한 접근 권한이 필요합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega нужен доступ к вашим фотографиям, чтобы вы могли прикрепить чек или фото витрины при добавлении магазина."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega 需要访问您的照片，以便您在报告便利店时附上收据或店面图片。"
          }
        }
      }
    }
  },
  "version" : "1.0"
