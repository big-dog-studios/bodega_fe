    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega আপনার কাছাকাছি বোডেগা খুঁজে পেতে আপনার অবস্থান ব্যবহার করে।"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Bodega χρησιμοποιεί την τοποθεσία σας για να βρει μπακάλικα κοντά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega uses your location to find bodegas near you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega usa tu ubicación para encontrar bodegas cerca de ti."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega itilize kote ou ye pou jwenn bodega toupre ou."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega는 근처 가게를 찾기 위해 위치 정보를 사용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega использует ваше местоположение, чтобы найти магазины поблизости."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bodega 使用您的位置来查找附近的便利店。"
          }
        }
      }
    }
  },
  "version" : "1.0"
