# Production build (incl. native iOS/Android): there is no Vite dev proxy, so the
# app must hit the API gateway directly at its absolute URL. CORS is sidestepped
# on native by CapacitorHttp (see capacitor.config.ts), which routes fetch through
# the native HTTP layer. `npm run build` loads this file (production mode) and
# overrides the relative /api in .env.
VITE_API_BASE_URL=https://bodega-gateway-2q60deae.ue.gateway.dev

# Gateway API key (x-api-key). This file is committed, so set the real value in
# .env.production.local (git-ignored) or your CI build env — not here.
# VITE_API_KEY=
